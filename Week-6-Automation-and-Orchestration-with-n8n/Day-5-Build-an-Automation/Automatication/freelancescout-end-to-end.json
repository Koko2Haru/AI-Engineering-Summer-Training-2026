    {
      "parameters": {
        "jsCode": "// Remove personal identifiers before any text reaches an external LLM.\nconst raw = $input.first().json.text || '';\nif (!raw.trim()) {\n  throw new Error('The uploaded file produced no extractable text. Is it a scanned image rather than a text PDF?');\n}\nconst cleaned = raw\n  .replace(/[\\w.+-]+@[\\w-]+\\.[\\w.]+/g, '[email removed]')\n  .replace(/\\+?\\d[\\d\\s().-]{7,}\\d/g, '[phone removed]')\n  .replace(/\\b(?:https?:\\/\\/|www\\.)\\S+/gi, '[link removed]');\nreturn [{ json: { cv_text: cleaned, cleaned_chars: cleaned.length } }];\n"
      },
      "id": "1a41bcda-0844-4120-bc8a-ddd196fd4f8d",
      "name": "Strip Personal Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2416,
        48
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a CV parser. Read the CV text below, summarise it, and produce a structured skill profile.\n\nReturn ONLY valid JSON. No markdown fences, no commentary. Use exactly this shape:\n{\n  \"summary\": \"2-3 plain-English sentences describing who this person is professionally and what they do best\",\n  \"headline\": \"one line describing this person professionally\",\n  \"seniority\": \"junior | mid | senior\",\n  \"core_skills\": [\"skills they are genuinely strong in\"],\n  \"secondary_skills\": [\"skills they have touched but are not specialists in\"],\n  \"domains\": [\"industries or problem areas they have worked in\"],\n  \"not_suited_to\": [\"kinds of work this person should NOT be matched with\"]\n}\n\nOnly list skills that actually appear in the CV. Do not infer or invent skills.\n\nCV TEXT:\n{{ $json.cv_text }}"
      },
      "id": "5f6c39b8-72f7-45cf-a6d0-355f26cba529",
      "name": "Summarize and Profile CV",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
