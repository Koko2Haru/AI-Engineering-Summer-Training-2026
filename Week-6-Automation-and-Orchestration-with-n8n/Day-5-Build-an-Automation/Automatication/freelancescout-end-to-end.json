    {
      "parameters": {
        "jsCode": "// Validate and unpack the profile step so the summary is usable downstream.\nlet raw = $input.first().json.text ?? $input.first().json.output ?? '';\nraw = String(raw).replace(/```json/gi, '').replace(/```/g, '').trim();\n\nlet p;\ntry {\n  p = JSON.parse(raw);\n} catch (e) {\n  throw new Error('Profile step did not return valid JSON. First 300 chars: ' + raw.slice(0, 300));\n}\n\nreturn [{\n  json: {\n    summary: p.summary ?? '(no summary returned)',\n    headline: p.headline ?? '',\n    seniority: p.seniority ?? '',\n    profile_json: JSON.stringify(p),\n  }\n}];\n"
      },
