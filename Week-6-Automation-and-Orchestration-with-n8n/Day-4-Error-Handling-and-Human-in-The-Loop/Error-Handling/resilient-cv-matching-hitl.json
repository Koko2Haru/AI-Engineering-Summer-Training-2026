    {
      "parameters": {
        "jsCode": "// Turn the pitch step's JSON array into one item per match.\nlet raw = $input.first().json.text ?? $input.first().json.output ?? '';\nraw = String(raw).replace(/```json/gi, '').replace(/```/g, '').trim();\n\nlet pitches;\ntry {\n  pitches = JSON.parse(raw);\n} catch (e) {\n  throw new Error('Pitch step did not return valid JSON. First 300 chars: ' + raw.slice(0, 300));\n}\n\nconst stamp = new Date().toISOString().slice(0, 16).replace('T', ' ');\nreturn pitches.map((p, i) => ({\n  json: { rank: i + 1, title: p.title, url: p.url, score: p.score, pitch: p.pitch, matched_at: stamp }\n}));\n"
      },
      "id": "3d2b779d-7e85-4446-bffe-0ba4ae753fb0",
      "name": "Split Pitches",
      "type": "n8n-nodes-base.code",
