    {
      "parameters": {
        "jsCode": "// Parse the scoring step's JSON, sort by score, keep the best 5.\n// Throws a readable error rather than passing malformed data downstream.\nlet raw = $input.first().json.text ?? $input.first().json.output ?? '';\nraw = String(raw).replace(/```json/gi, '').replace(/```/g, '').trim();\n\nlet scored;\ntry {\n  scored = JSON.parse(raw);\n} catch (e) {\n  throw new Error('Scoring step did not return valid JSON. First 300 chars: ' + raw.slice(0, 300));\n}\nif (!Array.isArray(scored)) {\n  throw new Error('Scoring step returned ' + typeof scored + ', expected an array.');\n}\nif (scored.length === 0) {\n  throw new Error('Scoring step returned an empty array - no jobs were scored.');\n}\n\nscored.sort((a, b) => (b.score ?? 0) - (a.score ?? 0));\nreturn [{ json: { top: scored.slice(0, 5), total_scored: scored.length } }];\n"
      },
      "id": "9453f760-4d9d-4e58-9883-9a7da2464c26",
      "name": "Rank and Take Top 5",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -368,
        -544
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a short application pitch for each freelance project below, written in the voice of the freelancer.\n\nFREELANCER PROFILE:\n{{ $('Extract Skill Profile').first().json.text }}\n\nTOP PROJECTS:\n{{ JSON.stringify($json.top) }}\n\nFor each project write 3-4 sentences that:\n- open with the specific, relevant experience for THAT project\n- reference only skills and projects actually present in the profile\n- state concretely what you would do first\n- avoid greetings, sign-offs, and filler like \"I am excited\"\n\nNever invent experience the profile does not contain.\n\nReturn ONLY a valid JSON array, no markdown fences:\n[{\"title\": \"...\", \"url\": \"...\", \"score\": 0, \"pitch\": \"...\"}]"
      },
      "id": "6d5badb9-6b4a-42d4-9dbb-e1735ca3527c",
      "name": "Write Pitches",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.6,
      "position": [
        -176,
        -544
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
