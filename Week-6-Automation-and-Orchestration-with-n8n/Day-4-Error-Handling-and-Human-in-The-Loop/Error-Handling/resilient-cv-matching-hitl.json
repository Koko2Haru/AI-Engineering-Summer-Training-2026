    {
      "parameters": {
        "jsCode": "// Remove personal identifiers before any text reaches an external LLM.\nconst raw = $input.first().json.text || '';\nif (!raw.trim()) {\n  throw new Error('CV text is empty - the uploaded file produced no extractable text. Is it a scanned image rather than a text PDF?');\n}\nconst cleaned = raw\n  .replace(/[\\w.+-]+@[\\w-]+\\.[\\w.]+/g, '[email removed]')\n  .replace(/\\+?\\d[\\d\\s().-]{7,}\\d/g, '[phone removed]')\n  .replace(/\\b(?:https?:\\/\\/|www\\.)\\S+/gi, '[link removed]');\nreturn [{ json: { cv_text: cleaned, cleaned_chars: cleaned.length } }];\n"
      },
      "id": "a29e3dbf-ddf9-4c64-aea0-22c246bac6d0",
      "name": "Strip Personal Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
