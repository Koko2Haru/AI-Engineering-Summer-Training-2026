        "groqApi": {
          "id": "W1O2GB3CUIkzIO9t",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Turn the pitch step's JSON array into one item per match, ready for Sheets.\nlet raw = $input.first().json.text ?? $input.first().json.output ?? '';\nraw = String(raw).replace(/```json/gi, '').replace(/```/g, '').trim();\n\nlet pitches;\ntry {\n  pitches = JSON.parse(raw);\n} catch (e) {\n  throw new Error('Pitch step did not return valid JSON. First 300 chars: ' + raw.slice(0, 300));\n}\n\nconst stamp = new Date().toISOString().slice(0, 16).replace('T', ' ');\n\nreturn pitches.map(p => ({\n  json: {\n    rank: pitches.indexOf(p) + 1,\n    title: p.title,\n    url: p.url,\n    score: p.score,\n    pitch: p.pitch,\n    matched_at: stamp,\n  }\n}));\n"
      },
