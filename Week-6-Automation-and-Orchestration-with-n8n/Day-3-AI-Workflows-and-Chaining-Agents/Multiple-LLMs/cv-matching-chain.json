    {
      "parameters": {
        "jsCode": "// Remove personal identifiers before any text reaches an external LLM.\n// Skills and experience are what matter for matching; name, email, phone and\n// profile links contribute nothing and should not leave the workflow.\nconst raw = $input.first().json.text || '';\n\nconst cleaned = raw\n  .replace(/[\\w.+-]+@[\\w-]+\\.[\\w.]+/g, '[email removed]')\n  .replace(/\\+?\\d[\\d\\s().-]{7,}\\d/g, '[phone removed]')\n  .replace(/\\b(?:https?:\\/\\/|www\\.)\\S+/gi, '[link removed]');\n\nreturn [{ json: { cv_text: cleaned, original_chars: raw.length, cleaned_chars: cleaned.length } }];\n"
      },
      "id": "4903077e-5b87-40c2-b3ca-b9f93f3ae894",
      "name": "Strip Personal Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        -240
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a CV parser. Read the CV text below and produce a structured skill profile.\n\nReturn ONLY valid JSON. No markdown fences, no commentary. Use exactly this shape:\n{\n  \"headline\": \"one line describing this person professionally\",\n  \"seniority\": \"junior | mid | senior\",\n  \"core_skills\": [\"skills they are genuinely strong in\"],\n  \"secondary_skills\": [\"skills they have touched but are not specialists in\"],\n  \"domains\": [\"industries or problem areas they have worked in\"],\n  \"not_suited_to\": [\"kinds of work this person should NOT be matched with\"]\n}\n\nOnly list skills that actually appear in the CV. Do not infer or invent skills.\n\nCV TEXT:\n{{ $json.cv_text }}"
      },
      "id": "a7a2d584-42f7-45e1-9350-c5dffd6cbf46",
      "name": "Extract Skill Profile",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
