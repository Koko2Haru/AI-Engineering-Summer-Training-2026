              "type": "string"
            },
            {
              "id": "f5",
              "name": "budget",
              "value": "={{ $json.budget ? ($json.budget.minimum + ' - ' + $json.budget.maximum) : '' }}",
              "type": "string"
            },
            {
              "id": "f6",
              "name": "currency",
              "value": "={{ $json.currency ? $json.currency.code : '' }}",
              "type": "string"
            },
            {
              "id": "f7",
              "name": "bids",
              "value": "={{ $json.bid_stats ? $json.bid_stats.bid_count : 0 }}",
              "type": "number"
            },
            {
              "id": "f8",
              "name": "posted",
              "value": "={{ new Date($json.time_submitted * 1000).toISOString().slice(0,16).replace('T',' ') }}",
              "type": "string"
            }
          ]
