      "id": "cccc0003-0000-4000-8000-000000000003",
      "name": "Has a CV?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -100,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// One job, not five - that is the whole difference between the digest and\n// \"find me work\". mode tags the row in the Matches sheet so the write-up can\n// show which suggestions were asked for and which arrived unprompted.\n\nconst cfg = $('Config').first().json;\n\nreturn [{ json: {\n  top_k: 1,\n  mode: 'daily',\n  bridge: cfg.bridge,\n  dm_channel_id: cfg.dm_channel_id,\n} }];"
      },
      "id": "cccc0004-0000-4000-8000-000000000004",
      "name": "Digest Params",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        -120
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "cccc0005-0000-4000-8000-000000000005",
      "name": "Run Job Matching",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        340,
        -120
      ],
      "notes": "SET ME: pick 'Rafid - Job Matching', or switch to 'By ID' and paste its id.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// FR-32: say something even when there is nothing. Silence reads as broken.\n\nconst cfg = $('Config').first().json;\nconst res = $input.first().json || {};\nconst m = (res.matches || [])[0];\n\nif (!m) {\n  return [{ json: {\n    dm_channel_id: cfg.dm_channel_id,\n    text: '\\uD83C\\uDF19 **Nothing new today.**\\nEvery live project that fits your CV has already been sent your way. I will keep looking and send one tomorrow morning.',\n  } }];\n}\n\nconst budget = String(m.budget || '').trim();\nconst lines = [\n  '\\u2600\\uFE0F **Good morning - one gig for you today**',\n  '',\n  '**' + m.title + '**  \\u2014  ' + m.score + '/100' + (budget ? '  \\u00B7  ' + budget : ''),\n];\n\nlet pitch = String(m.pitch || '').trim();\nif (pitch.length > 600) pitch = pitch.slice(0, 597) + '...';\nif (pitch) {\n  lines.push('');\n  lines.push('_Your opening line:_');\n  lines.push('> ' + pitch);\n}\nif (m.url) {\n  lines.push('');\n  lines.push(m.url);\n}\n\nlet text = lines.join('\\n');\nif (text.length > 1950) text = text.slice(0, 1940) + '\\n\\u2026';\n\nreturn [{ json: { dm_channel_id: cfg.dm_channel_id, text } }];"
      },
      "id": "cccc0006-0000-4000-8000-000000000006",
      "name": "Format Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        -120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://discord.com/api/v10/channels/{{ $json.dm_channel_id }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "discordBotApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{ $json.text }}"
            }
          ]
        },
        "options": {}
      },
      "id": "cccc0007-0000-4000-8000-000000000007",
      "name": "Send Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        -120
      ]
    },
