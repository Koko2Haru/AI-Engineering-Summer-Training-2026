            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "hascv",
              "leftValue": "={{ $json.state.cv_optimised_name || $json.state.cv_name || '' }}",
              "rightValue": "",
              "operator": {
